# Production environment template for Falcoria
# Copy this file to .env.prod or run ./scripts/generate-env.sh to generate values automatically.

# Database credentials
POSTGRES_PASSWORD=replace_with_strong_password

# Scanledger authentication tokens (seeded on startup, must all differ)
SCANLEDGER_ADMIN_TOKEN=replace_with_strong_admin_token
SCANLEDGER_TASKER_TOKEN=replace_with_strong_tasker_token
SCANLEDGER_WORKER_TOKEN=replace_with_strong_worker_token
# Optional: seeds an `asm` account for the event-feed consumer; leave empty to skip.
SCANLEDGER_ASM_TOKEN=

# Service ports and logging
TASKER_PORT=8000
LOG_LEVEL=INFO

# Application concurrency (number of uvicorn worker processes)
SCANLEDGER_WORKERS=4
TASKER_WORKERS=4

# Hatchet client (tasker, scanner and uploader each read their own prefix)
TASKER_HATCHET_TOKEN=replace_with_hatchet_token
TASKER_HATCHET_HOST_PORT=hatchet.example.com:7077
TASKER_HATCHET_TLS_STRATEGY=tls
WORKER_HATCHET_TOKEN=replace_with_hatchet_token
WORKER_HATCHET_HOST_PORT=hatchet.example.com:7077
WORKER_HATCHET_TLS_STRATEGY=tls

# Optional container image overrides (defaults to local build if omitted)
# SCANLEDGER_IMAGE=ghcr.io/OWNER/falcoria-scanledger:latest
# TASKER_IMAGE=ghcr.io/OWNER/falcoria-tasker:latest
# WORKER_IMAGE=ghcr.io/OWNER/falcoria-worker:latest
