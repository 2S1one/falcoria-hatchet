# Copy to deploy/.env. Every value below has a development default in the compose files, so
# a missing line is not an error; change the passwords and tokens for anything but a local run.
# deploy/.env is ignored by git.

# Hatchet engine version (also the tag of its migration, admin and dashboard images).
HATCHET_VERSION=v0.110.5

# Hatchet API token for every application. Create it after the infrastructure is up:
#   deploy/scripts/create-hatchet-token.sh
HATCHET_TOKEN=

# Passwords of the databases (applied on the first start of an empty volume only).
POSTGRES_ADMIN_PASSWORD=postgres-dev
SCANLEDGER_DB_PASSWORD=scanledger-dev
ASM_CORE_DB_PASSWORD=asm-core-dev
HATCHET_DB_PASSWORD=hatchet-dev
RABBITMQ_PASSWORD=rabbitmq-dev

# scanledger service tokens. All four must differ.
SCANLEDGER_ADMIN_TOKEN=admin-token-dev
SCANLEDGER_TASKER_TOKEN=tasker-token-dev
SCANLEDGER_WORKER_TOKEN=worker-token-dev
SCANLEDGER_ASM_TOKEN=asm-token-dev

# Ports published on the host.
POSTGRES_PORT=5436
HATCHET_GRPC_PORT=7070
HATCHET_DASHBOARD_PORT=8088
SCANLEDGER_PORT=8101
TASKER_PORT=8102
ASM_API_PORT=8103
