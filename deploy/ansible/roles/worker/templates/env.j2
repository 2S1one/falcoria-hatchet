{{ ansible_managed | comment }}
HATCHET_CLIENT_TOKEN={{ worker_hatchet_token }}
HATCHET_CLIENT_HOST_PORT={{ worker_engine_host }}:{{ hatchet_grpc_port }}
HATCHET_CLIENT_TLS_STRATEGY=mtls
HATCHET_CLIENT_TLS_ROOT_CA_FILE=/certs/ca.crt
HATCHET_CLIENT_TLS_CERT_FILE=/certs/client.crt
HATCHET_CLIENT_TLS_KEY_FILE=/certs/client.key
HATCHET_CLIENT_TLS_SERVER_NAME={{ hatchet_engine_name }}
{% if worker_kind == 'nmap' %}

WORKER_HATCHET_TOKEN={{ worker_hatchet_token }}
WORKER_HATCHET_HOST_PORT={{ worker_engine_host }}:{{ hatchet_grpc_port }}
WORKER_HATCHET_TLS_STRATEGY=mtls
{% endif %}
